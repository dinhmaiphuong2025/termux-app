<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="tab_bar_category"
        app:title="@string/termux_tab_bar_header">

        <SwitchPreferenceCompat
            app:key="show_tab_bar"
            app:title="@string/termux_tab_bar_title"
            app:summary="@string/termux_tab_bar_summary"
            app:defaultValue="true" />

        <SeekBarPreference
            app:key="tab_corner_radius"
            app:title="@string/termux_tab_bar_corner_radius_title"
            app:min="0"
            android:max="24"
            app:showSeekBarValue="true"
            app:defaultValue="1" />

        <SeekBarPreference
            app:key="tab_border_width"
            app:title="@string/termux_tab_bar_border_width_title"
            app:min="0"
            android:max="4"
            app:showSeekBarValue="true"
            app:defaultValue="1" />

        <Preference
            app:key="tab_border_color"
            app:title="@string/termux_tab_bar_border_color_title"
            app:summary="@string/termux_tab_bar_border_color_summary" />

        <SeekBarPreference
            app:key="tab_button_width"
            app:title="@string/termux_tab_bar_button_width_title"
            app:summary="@string/termux_tab_bar_button_width_summary"
            app:min="20"
            android:max="72"
            app:showSeekBarValue="true"
            app:defaultValue="28" />

        <SeekBarPreference
            app:key="tab_new_button_width"
            app:title="@string/termux_tab_bar_new_button_width_title"
            app:summary="@string/termux_tab_bar_new_button_width_summary"
            app:min="20"
            android:max="72"
            app:showSeekBarValue="true"
            app:defaultValue="28" />

        <SeekBarPreference
            app:key="tab_close_button_width"
            app:title="@string/termux_tab_bar_close_button_width_title"
            app:summary="@string/termux_tab_bar_close_button_width_summary"
            app:min="20"
            android:max="72"
            app:showSeekBarValue="true"
            app:defaultValue="28" />

        <SeekBarPreference
            app:key="tab_settings_button_width"
            app:title="@string/termux_tab_bar_settings_button_width_title"
            app:summary="@string/termux_tab_bar_settings_button_width_summary"
            app:min="20"
            android:max="72"
            app:showSeekBarValue="true"
            app:defaultValue="28" />

        <SeekBarPreference
            app:key="tab_active_title_length"
            app:title="@string/termux_tab_bar_active_title_length_title"
            app:summary="@string/termux_tab_bar_active_title_length_summary"
            app:min="0"
            android:max="30"
            app:showSeekBarValue="true"
            app:defaultValue="12" />

        <SwitchPreferenceCompat
            app:key="tab_animation_enabled"
            app:title="@string/termux_tab_animation_title"
            app:summary="@string/termux_tab_animation_summary"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="show_session_name_without_tab_bar"
            app:title="@string/termux_tab_bar_show_session_name_without_tab_bar_title"
            app:summary="@string/termux_tab_bar_show_session_name_without_tab_bar_summary"
            app:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="gesture_pill_category"
        app:title="@string/termux_gesture_pill_header">

        <SwitchPreferenceCompat
            app:key="gesture_pill_enabled"
            app:title="@string/termux_gesture_pill_enable_title"
            app:summary="@string/termux_gesture_pill_enable_summary"
            app:defaultValue="true" />

        <SeekBarPreference
            app:key="gesture_pill_width"
            app:title="@string/termux_gesture_pill_width_title"
            app:min="30"
            android:max="240"
            app:showSeekBarValue="true"
            app:defaultValue="90" />

        <SeekBarPreference
            app:key="gesture_pill_height"
            app:title="@string/termux_gesture_pill_height_title"
            app:min="4"
            android:max="40"
            app:showSeekBarValue="true"
            app:defaultValue="14" />

        <SeekBarPreference
            app:key="gesture_pill_corner_radius"
            app:title="@string/termux_gesture_pill_corner_radius_title"
            app:min="0"
            android:max="30"
            app:showSeekBarValue="true"
            app:defaultValue="20" />

        <Preference
            app:key="gesture_pill_color"
            app:title="@string/termux_gesture_pill_color_title"
            app:summary="@string/termux_gesture_pill_color_summary" />

        <ListPreference
            app:key="gesture_pill_swipe_left"
            app:title="@string/termux_gesture_pill_swipe_left_title"
            app:entries="@array/gesture_pill_action_titles"
            app:entryValues="@array/gesture_pill_action_values"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="prev_tab" />

        <ListPreference
            app:key="gesture_pill_swipe_right"
            app:title="@string/termux_gesture_pill_swipe_right_title"
            app:entries="@array/gesture_pill_action_titles"
            app:entryValues="@array/gesture_pill_action_values"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="next_tab" />

        <ListPreference
            app:key="gesture_pill_swipe_up"
            app:title="@string/termux_gesture_pill_swipe_up_title"
            app:entries="@array/gesture_pill_action_titles"
            app:entryValues="@array/gesture_pill_action_values"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="open_keyboard" />

        <ListPreference
            app:key="gesture_pill_swipe_down"
            app:title="@string/termux_gesture_pill_swipe_down_title"
            app:entries="@array/gesture_pill_action_titles"
            app:entryValues="@array/gesture_pill_action_values"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="close_keyboard" />

        <ListPreference
            app:key="gesture_pill_tap"
            app:title="@string/termux_gesture_pill_tap_title"
            app:entries="@array/gesture_pill_action_titles"
            app:entryValues="@array/gesture_pill_action_values"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="toggle_keyboard" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="niri_border_category"
        app:title="@string/termux_niri_border_header">

        <SwitchPreferenceCompat
            app:key="terminal_border_enabled"
            app:title="@string/termux_niri_border_enable_title"
            app:summary="@string/termux_niri_border_enable_summary"
            app:defaultValue="true" />

        <SeekBarPreference
            app:key="terminal_border_corner_radius"
            app:title="@string/termux_niri_border_corner_radius_title"
            app:min="0"
            android:max="32"
            app:showSeekBarValue="true"
            app:defaultValue="1" />

        <SeekBarPreference
            app:key="terminal_border_width"
            app:title="@string/termux_niri_border_width_title"
            app:min="1"
            android:max="8"
            app:showSeekBarValue="true"
            app:defaultValue="1" />

        <Preference
            app:key="terminal_border_color"
            app:title="@string/termux_niri_border_color_title"
            app:summary="@string/termux_niri_border_color_summary" />

        <SeekBarPreference
            app:key="terminal_border_gaps"
            app:title="@string/termux_niri_border_gaps_title"
            app:min="0"
            android:max="20"
            app:showSeekBarValue="true"
            app:defaultValue="4" />

        <SeekBarPreference
            app:key="terminal_horizontal_margin"
            app:title="@string/termux_niri_border_horizontal_margin_title"
            app:summary="@string/termux_niri_border_horizontal_margin_summary"
            app:min="0"
            android:max="30"
            app:showSeekBarValue="true"
            app:defaultValue="3" />

        <ListPreference
            app:key="terminal_border_style"
            app:title="@string/termux_niri_border_style_title"
            app:summary="@string/termux_niri_border_style_summary"
            app:entries="@array/terminal_border_style_titles"
            app:entryValues="@array/terminal_border_style_values"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="full" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="background_category"
        app:title="@string/termux_background_header">

        <Preference
            app:key="terminal_background_pick"
            app:title="@string/termux_background_pick_title"
            app:summary="@string/termux_background_pick_summary" />

        <Preference
            app:key="terminal_background_clear"
            app:title="@string/termux_background_clear_title"
            app:summary="@string/termux_background_clear_summary" />

        <EditTextPreference
            app:key="terminal_background_image_path"
            app:title="@string/termux_background_image_path_title"
            app:summary="@string/termux_background_image_path_summary"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="" />

        <SeekBarPreference
            app:key="terminal_background_opacity"
            app:title="@string/termux_background_opacity_title"
            app:min="0"
            android:max="100"
            app:showSeekBarValue="true"
            app:defaultValue="60" />

        <SwitchPreferenceCompat
            app:key="terminal_cell_background_transparency"
            app:title="@string/termux_cell_background_transparency_title"
            app:summary="@string/termux_cell_background_transparency_summary"
            app:defaultValue="false" />

        <SeekBarPreference
            app:key="terminal_cell_background_opacity"
            app:title="@string/termux_cell_background_opacity_title"
            app:min="0"
            android:max="100"
            app:showSeekBarValue="true"
            app:defaultValue="0" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="view"
        app:title="@string/termux_terminal_view_view_header">

        <SwitchPreferenceCompat
            app:key="terminal_margin_adjustment"
            app:summaryOff="@string/termux_terminal_view_terminal_margin_adjustment_off"
            app:summaryOn="@string/termux_terminal_view_terminal_margin_adjustment_on"
            app:title="@string/termux_terminal_view_terminal_margin_adjustment_title" />

    </PreferenceCategory>

</PreferenceScreen>
