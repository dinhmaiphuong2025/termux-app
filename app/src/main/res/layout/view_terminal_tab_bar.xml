<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminal_tab_bar_layout"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/terminal_tab_bar_full_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <HorizontalScrollView
            android:id="@+id/terminal_tabs_scroll_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/terminal_tabs_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/tab_new_session_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/shape_tab_pill_inactive"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="false"
            android:contentDescription="@string/action_new_session">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tab_plus"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tab_close_session_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/shape_tab_pill_inactive"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="false"
            android:contentDescription="@string/action_close_session">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close_tab"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tab_settings_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/shape_tab_pill_inactive"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="false"
            android:contentDescription="@string/action_open_settings">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                android:tint="#FFFFFFFF"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/terminal_session_title_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/terminal_session_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#B3FFFFFF"
            android:singleLine="true"
            android:ellipsize="end"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

</FrameLayout>
