<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tab_item_root"
    android:layout_width="wrap_content"
    android:layout_height="28dp"
    android:layout_marginEnd="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="6dp"
    android:background="@drawable/shape_tab_pill_inactive"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tab_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxLength="16"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:clickable="false"
        android:focusable="false"
        tools:text="1. zsh" />

    <ImageView
        android:id="@+id/tab_item_close"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:padding="2dp"
        android:contentDescription="Close Tab"
        android:src="@drawable/ic_close_tab"
        android:alpha="0.8"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</LinearLayout>
